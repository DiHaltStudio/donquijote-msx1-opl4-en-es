    {
      "id": "b_basic_0070_0",
      "text": "NAME?"
    },
    {
      "id": "b_basic_5000_0",
      "text": "YOU TRIP ON A STONE AND HURT YOUR LEG. SLOWLY, YOU GET UP."
    },
    {
      "id": "b_basic_6536_0",
      "text": "IT IS TOO COLD."
    },
    {
      "id": "b_basic_8002_0",
      "text": "LOAD OR SAVE ERROR"
    }
  ]
}
